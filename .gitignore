# Machine-specific paths, datasets, model weights and generated artifacts.
/configs/experiment.yaml
/configs/direction1.yaml
/configs/direction1_trials/
/runs/
/cache/
/artifacts/
/reports/**
/logs/**
/pseudo_large/
/__pycache__/
/src/__pycache__/
/tests/__pycache__/
*.pt
*.pth
*.onnx
*.engine
*.zip
*.tar
*.tar.gz

# Scene811 generated inventory / large machine outputs.
/reports/scene811_v1/
/tmp/
pytest-cache-files-*/
/test_tmp_*/

# Machine-resolved configs may contain absolute data and weight paths.  Keep
# portable examples in Git and place generated/local variants under these names.
/configs/*.local.yaml
/configs/baseline.yaml
/configs/experiment.yaml
/configs/global_kd.yaml
/configs/fah_kd.yaml
/configs/generated/

# Only aggregate, non-sensitive provenance belongs in the tracked evidence tree.
# Raw predictions, images, checkpoints and caches stay in the ignored paths above.
/evidence/runs/**/raw/
/evidence/runs/**/visuals/

# Python and IDE files.
.venv/
.idea/
.pytest_cache/
*.py[cod]
